# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Dependency lock files are committed for reproducible builds.

# Ignore files created by npm
node_modules

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Ignore the main.min.js since it should be built as part of jekyll-build.yml
assets/js/main.min.js

.jekyll-cache/
.jekyll-metadata
# Keep local verification reports and archives out of version control.
local/
